{
    "name": "appsolutely/sdk-php",
    "description": "Framework-free PHP client for Appsolutely relying parties: OpenID Connect sign-in, the machine token for the party's API calls, and verified Standard Webhooks deliveries.",
    "type": "library",
    "license": "MIT",
    "keywords": ["appsolutely", "openid-connect", "oauth2", "pkce", "standard-webhooks", "sdk"],
    "homepage": "https://github.com/appsolutely-io/sdk-php",
    "support": {
        "issues": "https://github.com/appsolutely-io/sdk-php/issues",
        "source": "https://github.com/appsolutely-io/sdk-php",
        "security": "https://github.com/appsolutely-io/sdk-php/security/policy"
    },
    "require": {
        "php": "^8.3",
        "composer-runtime-api": "^2.2",
        "firebase/php-jwt": "^7.0",
        "php-http/discovery": "^1.20",
        "psr/clock": "^1.0",
        "psr/http-client": "^1.0.3",
        "psr/http-factory": "^1.1",
        "psr/http-message": "^1.1 || ^2.0",
        "psr/log": "^2.0 || ^3.0",
        "psr/simple-cache": "^3.0"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.95",
        "nyholm/psr7": "^1.8.2",
        "php-http/client-common": "^2.7",
        "php-http/message": "^1.16",
        "php-http/mock-client": "^1.6.1",
        "phpstan/phpstan": "^2.1",
        "phpstan/phpstan-strict-rules": "^2.0",
        "phpunit/phpunit": "^12.5 || ^13.0",
        "standard-webhooks/standard-webhooks": "1.0.2"
    },
    "autoload": {
        "psr-4": {
            "Appsolutely\\Sdk\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Appsolutely\\Sdk\\Tests\\": "tests/"
        }
    },
    "extra": {
        "branch-alias": {
            "dev-main": "0.1.x-dev"
        }
    },
    "config": {
        "allow-plugins": {
            "php-http/discovery": true
        },
        "sort-packages": true
    },
    "scripts": {
        "test": "phpunit",
        "analyse": "phpstan analyse --no-progress",
        "cs": "php-cs-fixer check --diff",
        "cs:fix": "php-cs-fixer fix",
        "check": [
            "@composer validate --strict",
            "@cs",
            "@analyse",
            "@test"
        ]
    },
    "scripts-descriptions": {
        "test": "Run the PHPUnit suite.",
        "analyse": "Run PHPStan at level max with strict rules.",
        "cs": "Check coding style (PER-CS 3.0) without changing files.",
        "cs:fix": "Fix coding style (PER-CS 3.0) in place.",
        "check": "Validate composer.json, then run cs, analyse and test."
    },
    "minimum-stability": "stable"
}
